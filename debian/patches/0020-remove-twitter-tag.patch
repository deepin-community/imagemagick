From: =?utf-8?q?Bastien_Roucari=C3=A8s?= <rouca@debian.org>
Date: Sat, 10 Oct 2026 22:41:03 +0200
Subject: remove twitter tag

find . -type f -exec perl -pi -e 's/^.*name="twitter:.*$\n?//g' {} \;

forwarded: not-needed
---
